# Local .terraform provider plugins and modules cache
.terraform/
**/.terraform/*

# Terraform state files (managed securely in GCS, never committed to git)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Execution plan cache and crash logs
*.tfplan
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local variable definitions (may contain secrets/credentials)
*.tfvars
*.tfvars.json

# CLI configuration files
.terraformrc
terraform.rc

# OS metadata files
.DS_Store
Thumbs.db